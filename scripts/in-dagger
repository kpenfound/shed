#!/bin/sh
# Runs a command in a Go container holding this repository and the pinned jj
# release, and prints its standard output. The command's exit code is not
# propagated: shed reads the go test -json stream instead. shed.toml runs
# proofs through this script so that tests never run on the host.
set -eu
root=$(cd "$(dirname "$0")/.." && pwd)
args=""
for a in "$@"; do
	case "$a" in
	*,*)
		echo "in-dagger: argument contains a comma: $a" >&2
		exit 2
		;;
	esac
	args="${args:+$args,}$a"
done
jj='set -e; v=0.45.1; a=$(uname -m); curl -fsSL https://github.com/jj-vcs/jj/releases/download/v$v/jj-v$v-$a-unknown-linux-musl.tar.gz | tar -xz -C /usr/local/bin ./jj'
exec dagger core container from --address golang:1.26-trixie \
	with-exec --args="sh,-c,$jj" \
	with-env-variable --name SHED_REQUIRE_JJ --value 1 \
	with-directory --path /src --source "$root" --exclude .git,.jj,.shed \
	with-workdir --path /src \
	with-mounted-temp --path /tmp \
	with-exec --args="$args" --expect=ANY \
	stdout
